        "ax3.scatter(dadt_pca[:, 0], dadt_pca[:, 1], alpha=0.7, color=colors_dadt,\n",
        "            label='DADT', s=120, marker='^', edgecolors='darkred', linewidth=0.5)\n",
        "\n",
        "# Add ellipses around clusters\n",
        "from matplotlib.patches import Ellipse\n",
        "\n",
        "def add_cluster_ellipse(ax, pca_data, color, n_std=2.0):\n",
        "    mean = pca_data.mean(axis=0)\n",
        "    cov = np.cov(pca_data.T)\n",
        "    eigenvals, eigenvecs = np.linalg.eig(cov)\n",
        "    angle = np.degrees(np.arctan2(eigenvecs[1, 0], eigenvecs[0, 0]))\n",
        "    width, height = 4 * np.sqrt(eigenvals)\n",
        "    ellipse = Ellipse(mean, width, height, angle=angle,\n",
        "                      facecolor=color, alpha=0.1, edgecolor=color, linewidth=2)\n",
        "    ax.add_patch(ellipse)\n",
        "\n",
        "add_cluster_ellipse(ax3, dmso_pca[:, :2], colors_dmso)\n",
        "add_cluster_ellipse(ax3, dadt_pca[:, :2], colors_dadt)\n",
        "\n",
        "ax3.set_xlabel(f'PC1 ({pca.explained_variance_ratio_[0]*100:.1f}%)', fontweight='bold')\n",
        "ax3.set_ylabel(f'PC2 ({pca.explained_variance_ratio_[1]*100:.1f}%)', fontweight='bold')\n",
        "ax3.set_title('PCA Plot with Cluster Ellipses', fontweight='bold')\n",
        "ax3.legend()\n",
        "ax3.grid(alpha=0.3)\n"
