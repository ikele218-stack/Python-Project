        "fig = plt.figure(figsize=(18, 12))\n",
        "gs = fig.add_gridspec(2, 3, hspace=0.3, wspace=0.3)\n",
        "fig.suptitle('Figure 3: Correlation Structure & PCA Advanced Analysis',\n",
