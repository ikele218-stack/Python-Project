    {
      "cell_type": "code",
      "source": [
        "\n",
        "# Correlation matrices\n",
        "dmso_corr = dmso_extracted[features].corr()\n",
        "dadt_corr = dadt_extracted[features].corr()\n",
        "\n",
        "ax1 = fig.add_subplot(gs[0, 0])\n",
        "sns.heatmap(dmso_corr, annot=True, fmt='.2f', cmap='coolwarm', center=0,\n",
