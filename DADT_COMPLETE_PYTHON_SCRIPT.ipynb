      },
      "source": [
        "================================================================================\n",
        "COMPREHENSIVE PYTHON SCRIPT FOR DRUG EXPERIMENT EDA\n",
        "Exploratory Data Analysis: DMSO vs DADT Treatment Comparison\n",
        "================================================================================\n",
        "\n",
        "This script performs complete analysis including:\n",
        "- Data loading and cleaning\n",
        "- Descriptive statistics\n",
        "- PCA analysis\n",
        "- Statistical testing\n",
        "- Advanced visualizations (Figures 1-5)\n",
        "\n",
        "Author: Data Analysis Pipeline\n",
        "Date: 2024\n",
        "================================================================================\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.decomposition import PCA\n",
        "from scipy import stats\n",
        "from scipy.stats import mannwhitneyu, ttest_ind\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')"
      ],
      "metadata": {
        "id": "T8xvFmvSON8t"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Set style for all plots\n",
        "sns.set_style(\"whitegrid\")\n",
        "plt.rcParams['figure.figsize'] = (14, 10)\n",
        "plt.rcParams['font.size'] = 10\n",
        "plt.rcParams['axes.labelsize'] = 11\n",
        "plt.rcParams['axes.titlesize'] = 12\n",
        "plt.rcParams['xtick.labelsize'] = 9\n",
        "plt.rcParams['ytick.labelsize'] = 9"
      ],
      "metadata": {
        "id": "_TUPa-xhPBxR"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"=\"*80)\n",
        "print(\"LOADING AND PREPARING DATA\")\n",
        "print(\"=\"*80)\n",
        "\n",
        "# Load the Excel file\n",
        "xls_file = 'Drug_experiment_analysis_copy.xls'\n",
        "df = pd.read_excel(xls_file, sheet_name='Sheet3')"
      ],
      "metadata": {
        "id": "W0Avx35gPD4a"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Extract data for each treatment\n",
        "dmso_data = df[(df['DIC'].str.strip() == 'DMSO') | (df['DIC'] == 'DMSO')].copy()\n",
        "dadt_data = df[(df['DIC'].str.strip() == 'DADT') | (df['DIC'] == 'DADT')].copy()\n"
      ],
      "metadata": {
        "id": "PDlB8ZJuPHfa"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Extract columns (Area, Mean, Min, Max, length)\n",
        "dmso_extracted = dmso_data[['Area', 'Mean', 'Min', 'Max', 'length']].dropna()\n",
        "dadt_extracted = dadt_data[['Area', 'Mean', 'Min', 'Max', 'length']].dropna()"
      ],
      "metadata": {
        "id": "fuNWBRebPKot"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Calculate additional features\n",
        "dmso_extracted['Range'] = dmso_extracted['Max'] - dmso_extracted['Min']\n",
        "dadt_extracted['Range'] = dadt_extracted['Max'] - dadt_extracted['Min']\n"
      ],
      "metadata": {
        "id": "B3PKNlKgPOCK"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "print(f\"DMSO samples: {len(dmso_extracted)}\")\n",
        "print(f\"DADT samples: {len(dadt_extracted)}\")"
      ],
      "metadata": {
        "id": "mNc0EgRgPP1Q"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Prepare data for analysis (excluding 'length')\n",
        "features = ['Area', 'Mean', 'Min', 'Max', 'Range']\n",
        "dmso_features = dmso_extracted[features].values\n",
        "dadt_features = dadt_extracted[features].values"
      ],
      "metadata": {
        "id": "PrC9STYJPRmz"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"DESCRIPTIVE STATISTICS\")\n",
        "print(\"=\"*80)"
      ],
      "metadata": {
        "id": "YhkJ2nwzPTh-"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# Calculate statistics\n",
        "dmso_stats = dmso_extracted[features].describe()\n",
        "dadt_stats = dadt_extracted[features].describe()\n",
        "\n",
        "print(\"\\nDMSO Statistics:\")\n",
        "print(dmso_stats)\n",
        "print(\"\\nDADT Statistics:\")\n",
        "print(dadt_stats)"
      ],
      "metadata": {
        "id": "kPHdhZ4_PYc0"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Calculate effect sizes (Cohen's d)\n",
        "def cohens_d(group1, group2):\n",
        "    n1, n2 = len(group1), len(group2)\n",
        "    var1, var2 = np.var(group1, ddof=1), np.var(group2, ddof=1)\n",
        "    pooled_std = np.sqrt(((n1-1)*var1 + (n2-1)*var2) / (n1+n2-2))\n",
        "    return (np.mean(group1) - np.mean(group2)) / pooled_std\n",
        "\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"STATISTICAL TESTING & EFFECT SIZES\")\n",
        "print(\"=\"*80)\n",
        "\n",
        "for feature in features:\n",
        "    dmso_vals = dmso_extracted[feature].values\n",
        "    dadt_vals = dadt_extracted[feature].values\n",
        "\n",
        "    # t-test\n",
        "    t_stat, p_val = ttest_ind(dmso_vals, dadt_vals)\n",
        "    # Mann-Whitney U test\n",
        "    u_stat, p_mw = mannwhitneyu(dmso_vals, dadt_vals)\n",
        "    # Cohen's d\n",
        "    d = cohens_d(dmso_vals, dadt_vals)\n",
        "\n",
        "    print(f\"\\n{feature}:\")\n",
        "    print(f\"  DMSO Mean: {np.mean(dmso_vals):.4f} ± {np.std(dmso_vals):.4f}\")\n",
        "    print(f\"  DADT Mean: {np.mean(dadt_vals):.4f} ± {np.std(dadt_vals):.4f}\")\n",
        "    print(f\"  Difference: {np.mean(dmso_vals) - np.mean(dadt_vals):.4f}\")\n",
        "    print(f\"  t-test p-value: {p_val:.2e}\")\n",
        "    print(f\"  Mann-Whitney U p-value: {p_mw:.2e}\")\n",
        "    print(f\"  Cohen's d: {d:.4f}\")\n",
        "\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"FIGURE 1: EXPLORATORY DISTRIBUTIONS\")\n",
        "print(\"=\"*80)"
      ],
      "metadata": {
        "id": "0VSk4qEnPZv5"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "fig, axes = plt.subplots(3, 3, figsize=(16, 12))\n",
        "fig.suptitle('Figure 1: Exploratory Distributions - DMSO vs DADT',\n",
        "             fontsize=16, fontweight='bold', y=0.995)\n",
        "\n",
        "features_list = ['Area', 'Mean', 'Min', 'Max', 'Range']\n",
        "colors_dmso, colors_dadt = '#3498db', '#e74c3c'\n",
        "\n",
        "for idx, feature in enumerate(features_list):\n",
        "    # Row 1: Histograms\n",
        "    axes[0, idx].hist(dmso_extracted[feature], bins=40, alpha=0.6,\n",
        "                      color=colors_dmso, label='DMSO', edgecolor='black')\n",
        "    axes[0, idx].hist(dadt_extracted[feature], bins=40, alpha=0.6,\n",
        "                      color=colors_dadt, label='DADT', edgecolor='black')\n",
        "    axes[0, idx].set_title(f'{feature} Distribution', fontweight='bold')\n",
        "    axes[0, idx].set_ylabel('Frequency')\n",
        "    axes[0, idx].legend()\n",
        "    axes[0, idx].grid(alpha=0.3)"
      ],
      "metadata": {
        "id": "swwlm9eoPek_"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "    # Row 2: Box plots\n",
        "    data_to_plot = [dmso_extracted[feature], dadt_extracted[feature]]\n",
        "    bp = axes[1, idx].boxplot(data_to_plot, labels=['DMSO', 'DADT'],\n",
        "                               patch_artist=True, showmeans=True)\n",
        "    for patch, color in zip(bp['boxes'], [colors_dmso, colors_dadt]):\n",
        "        patch.set_facecolor(color)\n",
        "        patch.set_alpha(0.6)\n",
        "    axes[1, idx].set_title(f'{feature} Box Plot', fontweight='bold')\n",
        "    axes[1, idx].set_ylabel('Value')\n",
        "    axes[1, idx].grid(alpha=0.3)\n"
      ],
      "metadata": {
        "id": "b6Vnd8H_PjG2"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "    # Row 3: Violin plots\n",
        "    parts = axes[2, idx].violinplot([dmso_extracted[feature], dadt_extracted[feature]],\n",
        "                                     positions=[1, 2], showmeans=True, showmedians=True)\n",
        "    axes[2, idx].set_xticks([1, 2])\n",
        "    axes[2, idx].set_xticklabels(['DMSO', 'DADT'])\n",
        "    axes[2, idx].set_title(f'{feature} Violin Plot', fontweight='bold')\n",
        "    axes[2, idx].set_ylabel('Value')\n",
        "    axes[2, idx].grid(alpha=0.3)\n",
        " # Remove extra subplot\n",
        "fig.delaxes(axes[0, 4])\n",
        "fig.delaxes(axes[1, 4])\n",
        "fig.delaxes(axes[2, 4])\n",
        "plt.tight_layout()\n",
        "plt.savefig('/outputs/01_exploratory_distributions.png', dpi=300, bbox_inches='tight')\n",
        "print(\"✓ Saved: 01_exploratory_distributions.png\")\n",
        "plt.close()\n",
        "\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"PCA ANALYSIS\")\n",
        "print(\"=\"*80)\n",
        "\n"
      ],
      "metadata": {
        "id": "JGB4mWTaPljF"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Standardize features\n",
        "scaler = StandardScaler()\n",
        "dmso_scaled = scaler.fit_transform(dmso_features)\n",
        "dadt_scaled = scaler.transform(dadt_features)\n",
        "\n",
        "# Combined data for PCA\n",
        "combined_data = np.vstack([dmso_scaled, dadt_scaled])\n",
        "combined_labels = np.hstack([np.zeros(len(dmso_scaled)), np.ones(len(dadt_scaled))])\n",
        "\n",
        "# Perform PCA\n",
        "pca = PCA()\n",
        "pca.fit(combined_data)\n",
        "dmso_pca = pca.transform(dmso_scaled)\n",
        "dadt_pca = pca.transform(dadt_scaled)"
      ],
      "metadata": {
        "id": "z0g82YsmPtOv"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Print variance explained\n",
        "print(f\"\\nPCA Variance Explained by Component:\")\n",
        "for i, var in enumerate(pca.explained_variance_ratio_[:5]):\n",
        "    print(f\"  PC{i+1}: {var*100:.2f}%\")\n",
        "\n",
        "cumulative_var = np.cumsum(pca.explained_variance_ratio_)\n",
        "print(f\"\\nCumulative Variance (PC1+PC2): {cumulative_var[1]*100:.2f}%\")\n",
        "print(f\"Cumulative Variance (PC1+PC2+PC3): {cumulative_var[2]*100:.2f}%\")\n",
        "\n",
        "# Print loadings\n",
        "print(f\"\\nPCA Loadings (PC1 & PC2):\")\n",
        "loadings_df = pd.DataFrame(\n",
        "    pca.components_[:2].T,\n",
        "    columns=['PC1', 'PC2'],\n",
        "    index=features\n",
        ")\n",
        "print(loadings_df)\n",
        "\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"FIGURE 2: PCA ANALYSIS\")\n",
        "print(\"=\"*80)\n",
        "\n",
        "fig, axes = plt.subplots(2, 2, figsize=(14, 12))\n",
        "fig.suptitle('Figure 2: Principal Component Analysis (PCA)',\n",
        "             fontsize=16, fontweight='bold', y=0.995)"
      ],
      "metadata": {
        "id": "ihmemHIrP3xw"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# PC1 vs PC2\n",
        "axes[0, 0].scatter(dmso_pca[:, 0], dmso_pca[:, 1], alpha=0.5,\n",
        "                   color=colors_dmso, label='DMSO', s=30)\n",
        "axes[0, 0].scatter(dadt_pca[:, 0], dadt_pca[:, 1], alpha=0.7,\n",
        "                   color=colors_dadt, label='DADT', s=100, marker='^')\n",
        "axes[0, 0].set_xlabel(f'PC1 ({pca.explained_variance_ratio_[0]*100:.2f}%)', fontweight='bold')\n",
        "axes[0, 0].set_ylabel(f'PC2 ({pca.explained_variance_ratio_[1]*100:.2f}%)', fontweight='bold')\n",
        "axes[0, 0].set_title('PC1 vs PC2: Treatment Separation', fontweight='bold')\n",
        "axes[0, 0].legend()\n",
        "axes[0, 0].grid(alpha=0.3)\n",
        "\n",
        "# Scree plot\n",
        "axes[0, 1].plot(range(1, 6), pca.explained_variance_ratio_[:5], 'o-',\n",
        "                linewidth=2, markersize=8, color='#2c3e50')\n",
        "axes[0, 1].fill_between(range(1, 6), pca.explained_variance_ratio_[:5], alpha=0.3)\n",
        "axes[0, 1].set_xlabel('Principal Component', fontweight='bold')\n",
        "axes[0, 1].set_ylabel('Variance Explained', fontweight='bold')\n",
        "axes[0, 1].set_title('Scree Plot', fontweight='bold')\n",
        "axes[0, 1].set_xticks(range(1, 6))\n",
        "axes[0, 1].grid(alpha=0.3)"
      ],
      "metadata": {
        "id": "80TwLK0RP9BL"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Cumulative variance\n",
        "axes[1, 0].plot(range(1, 6), cumulative_var[:5], 'o-',\n",
        "                linewidth=2, markersize=8, color='#27ae60')\n",
        "axes[1, 0].axhline(y=0.95, color='r', linestyle='--', label='95% threshold')\n",
        "axes[1, 0].fill_between(range(1, 6), cumulative_var[:5], alpha=0.3)\n",
        "axes[1, 0].set_xlabel('Number of Components', fontweight='bold')\n",
        "axes[1, 0].set_ylabel('Cumulative Variance Explained', fontweight='bold')\n",
        "axes[1, 0].set_title('Cumulative Variance', fontweight='bold')\n",
        "axes[1, 0].set_xticks(range(1, 6))\n",
        "axes[1, 0].set_ylim([0, 1.05])\n",
        "axes[1, 0].legend()\n",
        "axes[1, 0].grid(alpha=0.3)\n",
        "\n",
        "# Biplot\n",
        "loadings = pca.components_.T * np.sqrt(pca.explained_variance_)\n",
        "scale_factor = 3.5\n",
        "axes[1, 1].scatter(dmso_pca[:, 0], dmso_pca[:, 1], alpha=0.4,\n",
        "                   color=colors_dmso, label='DMSO', s=20)\n",
        "axes[1, 1].scatter(dadt_pca[:, 0], dadt_pca[:, 1], alpha=0.6,\n",
        "                   color=colors_dadt, label='DADT', s=80, marker='^')\n",
        "\n",
        "for i, feature_name in enumerate(features):\n",
        "    axes[1, 1].arrow(0, 0, loadings[i, 0]*scale_factor, loadings[i, 1]*scale_factor,\n",
        "                     head_width=0.3, head_length=0.2, fc='#2c3e50', ec='#2c3e50', linewidth=2)\n",
        "    axes[1, 1].text(loadings[i, 0]*scale_factor*1.15, loadings[i, 1]*scale_factor*1.15,\n",
        "                    feature_name, fontsize=11, fontweight='bold', ha='center', va='center')\n",
        "\n",
        "axes[1, 1].set_xlabel(f'PC1 ({pca.explained_variance_ratio_[0]*100:.2f}%)', fontweight='bold')\n",
        "axes[1, 1].set_ylabel(f'PC2 ({pca.explained_variance_ratio_[1]*100:.2f}%)', fontweight='bold')\n",
        "axes[1, 1].set_title('PCA Biplot - Feature Loadings', fontweight='bold')\n",
        "axes[1, 1].axhline(y=0, color='k', linestyle='-', linewidth=0.5, alpha=0.3)\n",
        "axes[1, 1].axvline(x=0, color='k', linestyle='-', linewidth=0.5, alpha=0.3)\n",
        "axes[1, 1].legend()\n",
        "axes[1, 1].grid(alpha=0.3)"
      ],
      "metadata": {
        "id": "txMKAgFhP98R"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "plt.tight_layout()\n",
        "plt.savefig('/outputs/02_pca_analysis.png', dpi=300, bbox_inches='tight')\n",
        "print(\"✓ Saved: 02_pca_analysis.png\")\n",
        "plt.close()\n",
        "\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"FIGURE 3: CORRELATION & PCA ADVANCED ANALYSIS\")\n",
