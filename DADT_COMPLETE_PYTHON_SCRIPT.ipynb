        "ax2 = fig.add_subplot(gs[0, 1])\n",
        "sns.heatmap(dadt_corr, annot=True, fmt='.2f', cmap='coolwarm', center=0,\n",
        "            cbar_kws={'label': 'Correlation'}, vmin=-1, vmax=1, ax=ax2,\n",
        "            linewidths=0.5, linecolor='gray')\n",
        "ax2.set_title('DADT Correlation Matrix', fontweight='bold', fontsize=12)"
