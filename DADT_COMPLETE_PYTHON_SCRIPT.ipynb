        "\n",
        "# PC1 vs PC2 with density\n",
        "ax3 = fig.add_subplot(gs[1, 0])\n",
        "ax3.scatter(dmso_pca[:, 0], dmso_pca[:, 1], alpha=0.5, color=colors_dmso,\n",
